# Copia este archivo como .env y llena los valores reales.
# El archivo .env NUNCA se sube al repositorio (está en .gitignore).

# --- Base de datos PostgreSQL ---
DB_USER=haztuhorario_app
DB_HOST=localhost
DB_NAME=haztuhorario_db
DB_PASSWORD=
DB_PORT=5432

# Poner en true solo si tu proveedor de base de datos exige SSL (Render, Supabase, Neon, etc.)
DB_SSL=false

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- CORS: orígenes autorizados, separados por coma, sin barra al final ---
# Desarrollo con Live Server:
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# En producción se reemplaza por el dominio real, por ejemplo:
# ALLOWED_ORIGINS=https://haztuhorario.com,https://www.haztuhorario.com

# --- Anti-spam ---
# Genera un valor aleatorio con: openssl rand -base64 32
RATE_LIMIT_SALT=
RATE_LIMIT_MAX=5
RATE_LIMIT_MINUTOS=15
